#######################################################################
# Test for copying block of size 63;
#######################################################################
	.pos 0
main:	irmovq Stack, %rsp  	# Set up stack pointer

	# Set up arguments for copy function and then invoke it
	irmovq $63, %rdx		# src and dst have 63 elements
	irmovq dest, %rsi	# dst array
	irmovq src, %rdi	# src array
	call ncopy		 
	halt			# should halt with num nonzeros in %rax
StartFun:
#/* $begin ncopy-ys */ (not my ver lol)
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion (I don't give a fuck, i write my own version)
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
# ncopy:

##################################################################
# You can modify this portion
#	# Loop header
#	xorq %rax,%rax		# count = 0;
#	andq %rdx,%rdx		# len <= 0?
#	jle Done		# if so, goto Done:
#
#Loop:	mrmovq (%rdi), %r10	# read val from src...
#	rmmovq %r10, (%rsi)	# ...and store it to dst
#	andq %r10, %r10		# val <= 0?
#	jle Npos		# if so, goto Npos:
#	irmovq $1, %r10
#	addq %r10, %rax		# count++
#Npos:	irmovq $1, %r10
#	subq %r10, %rdx		# len--
#	irmovq $8, %r10
#	addq %r10, %rdi		# src++
#	addq %r10, %rsi		# dst++
#	andq %rdx,%rdx		# len > 0?
#	jg Loop			# if so, goto Loop:
##################################################################
# Do not modify the following section of code
# Function epilogue.
#Done:
#	ret
##################################################################
# Keep the following label at the end of your function
#End:
#/* $end ncopy-ys */

##################################################################
##################################################################
##################################################################
######################## ncopy.ys ################################
######################### my ver #################################
##################################################################
##################################################################
##################################################################

ncopy:
	xorq %rax, %rax
Loop:
	# the jump tree (i am dumb, so gemini told me to try to build the tree to reach 9.00 avg CPE)
	# but the tree was made by myself
	iaddq $-3, %rdx
	je Three
	jl TwoMinus
	jmp FourPlus
TwoMinus:
	iaddq $2, %rdx
	je One
	jl Done
	jmp Two 
FourPlus:
	iaddq $-2, %rdx
	jl Four
	jmp FivePlus

One:
	mrmovq 0(%rdi), %r8
	iaddq $8, %rdi
	iaddq $8, %rsi
	andq %r8, %r8
	jle OneNotPos
	iaddq $1, %rax
OneNotPos:
	rmmovq %r8, -8(%rsi)
	jmp Done
Two:
	mrmovq 0(%rdi), %r8
	mrmovq 8(%rdi), %r9
	iaddq $16, %rdi
	iaddq $16, %rsi
	andq %r8, %r8
	jle TwoFirstNotPos
	iaddq $1, %rax
TwoFirstNotPos:
	andq %r9, %r9
	jle TwoSecondNotPos
	iaddq $1, %rax
TwoSecondNotPos:
	rmmovq %r8, -16(%rsi)
	rmmovq %r9, -8(%rsi)
	jmp Done
Three:
	mrmovq 0(%rdi), %r8
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi), %r10
	iaddq $24, %rdi
	iaddq $24, %rsi
	andq %r8, %r8
	jle ThreeFirstNotPos
	iaddq $1, %rax
ThreeFirstNotPos:
	andq %r9, %r9
	jle ThreeSecondNotPos
	iaddq $1, %rax
ThreeSecondNotPos:
	andq %r10, %r10
	jle ThreeThirdNotPos
	iaddq $1, %rax
ThreeThirdNotPos:
	rmmovq %r8, -24(%rsi)
	rmmovq %r9, -16(%rsi)
	rmmovq %r10, -8(%rsi)
	jmp Done
Four:
	mrmovq 0(%rdi), %r8
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi), %r10
	mrmovq 24(%rdi), %r11
	iaddq $32, %rdi
	iaddq $32, %rsi
	andq %r8, %r8
	jle FourFirstNotPos
	iaddq $1, %rax
FourFirstNotPos:
	andq %r9, %r9
	jle FourSecondNotPos
	iaddq $1, %rax
FourSecondNotPos:
	andq %r10, %r10
	jle FourThirdNotPos
	iaddq $1, %rax
FourThirdNotPos:
	andq %r11, %r11
	jle FourFourthNotPos
	iaddq $1, %rax
FourFourthNotPos:
	rmmovq %r8, -32(%rsi)
	rmmovq %r9, -24(%rsi)
	rmmovq %r10, -16(%rsi)
	rmmovq %r11, -8(%rsi)
	jmp Done
FivePlus:
	mrmovq 0(%rdi), %r8
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi), %r10
	mrmovq 24(%rdi), %r11
	mrmovq 32(%rdi), %r12
	iaddq $40, %rdi
	iaddq $40, %rsi
	andq %r8, %r8
	jle FiveFirstNotPos
	iaddq $1, %rax
FiveFirstNotPos:
	andq %r9, %r9
	jle FiveSecondNotPos
	iaddq $1, %rax
FiveSecondNotPos:
	andq %r10, %r10
	jle FiveThirdNotPos
	iaddq $1, %rax
FiveThirdNotPos:
	andq %r11, %r11
	jle FiveFourthNotPos
	iaddq $1, %rax
FiveFourthNotPos:
	andq %r12, %r12
	jle FiveFifthNotPos
	iaddq $1, %rax
FiveFifthNotPos:
	rmmovq %r8, -40(%rsi)
	rmmovq %r9, -32(%rsi)
	rmmovq %r10, -24(%rsi)
	rmmovq %r11, -16(%rsi)
	rmmovq %r12, -8(%rsi)
	
	jmp Loop
Done:
	ret
End:
EndFun:

