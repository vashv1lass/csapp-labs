##################################################################
######################## ncopy.ys ################################
######################### my ver #################################
##################################################################
##################################################################
##################################################################

# average CPE 8.85 is my max, i can't do more cuz im so dumb ye.
# i guess i need to decompose the cycle by the factor of 6 or 8
# but the program becomes too begin
# i'm a lil bit disappointed

ncopy:
	xorq %rax, %rax
Loop:
	# the jump tree (i am dumb, so gemini told me to try to build the tree to reach 9.00 avg CPE)
	# but the tree was made by myself
	iaddq $-3, %rdx
	je Three
	jl TwoMinus
	jmp FourPlus
TwoMinus:
	iaddq $2, %rdx
	je One
	jl Done
	jmp Two 
FourPlus:
	iaddq $-2, %rdx
	jl Four
	jmp FivePlus

One:
	mrmovq 0(%rdi), %r8
	iaddq $8, %rdi
	iaddq $8, %rsi
	andq %r8, %r8
	jle OneNotPos
	iaddq $1, %rax
OneNotPos:
	rmmovq %r8, -8(%rsi)
	jmp Done
Two:
	mrmovq 0(%rdi), %r8
	mrmovq 8(%rdi), %r9
	iaddq $16, %rdi
	iaddq $16, %rsi
	andq %r8, %r8
	jle TwoFirstNotPos
	iaddq $1, %rax
TwoFirstNotPos:
	andq %r9, %r9
	jle TwoSecondNotPos
	iaddq $1, %rax
TwoSecondNotPos:
	rmmovq %r8, -16(%rsi)
	rmmovq %r9, -8(%rsi)
	jmp Done
Three:
	mrmovq 0(%rdi), %r8
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi), %r10
	iaddq $24, %rdi
	iaddq $24, %rsi
	andq %r8, %r8
	jle ThreeFirstNotPos
	iaddq $1, %rax
ThreeFirstNotPos:
	andq %r9, %r9
	jle ThreeSecondNotPos
	iaddq $1, %rax
ThreeSecondNotPos:
	andq %r10, %r10
	jle ThreeThirdNotPos
	iaddq $1, %rax
ThreeThirdNotPos:
	rmmovq %r8, -24(%rsi)
	rmmovq %r9, -16(%rsi)
	rmmovq %r10, -8(%rsi)
	jmp Done
Four:
	mrmovq 0(%rdi), %r8
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi), %r10
	mrmovq 24(%rdi), %r11
	iaddq $32, %rdi
	iaddq $32, %rsi
	andq %r8, %r8
	jle FourFirstNotPos
	iaddq $1, %rax
FourFirstNotPos:
	andq %r9, %r9
	jle FourSecondNotPos
	iaddq $1, %rax
FourSecondNotPos:
	andq %r10, %r10
	jle FourThirdNotPos
	iaddq $1, %rax
FourThirdNotPos:
	andq %r11, %r11
	jle FourFourthNotPos
	iaddq $1, %rax
FourFourthNotPos:
	rmmovq %r8, -32(%rsi)
	rmmovq %r9, -24(%rsi)
	rmmovq %r10, -16(%rsi)
	rmmovq %r11, -8(%rsi)
	jmp Done
FivePlus:
	mrmovq 0(%rdi), %r8
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi), %r10
	mrmovq 24(%rdi), %r11
	mrmovq 32(%rdi), %r12
	iaddq $40, %rdi
	iaddq $40, %rsi
	andq %r8, %r8
	jle FiveFirstNotPos
	iaddq $1, %rax
FiveFirstNotPos:
	andq %r9, %r9
	jle FiveSecondNotPos
	iaddq $1, %rax
FiveSecondNotPos:
	andq %r10, %r10
	jle FiveThirdNotPos
	iaddq $1, %rax
FiveThirdNotPos:
	andq %r11, %r11
	jle FiveFourthNotPos
	iaddq $1, %rax
FiveFourthNotPos:
	andq %r12, %r12
	jle FiveFifthNotPos
	iaddq $1, %rax
FiveFifthNotPos:
	rmmovq %r8, -40(%rsi)
	rmmovq %r9, -32(%rsi)
	rmmovq %r10, -24(%rsi)
	rmmovq %r11, -16(%rsi)
	rmmovq %r12, -8(%rsi)
	
	jmp Loop
Done:
	ret
End:
