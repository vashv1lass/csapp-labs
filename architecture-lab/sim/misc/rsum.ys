        irmovq stack, %rsp

        irmovq ele1, %rdi
        call rsum_list

        halt

rsum_list:
        irmovq $0, %rax

        subq %rax, %rdi
        je rsum_list_done

        mrmovq 0(%rdi), %rdx
        pushq %rdx
        pushq %rax
        mrmovq 8(%rdi), %rdi
        call rsum_list
        rrmovq %rax, %r8
        popq %rax
        popq %rdx
        rrmovq %rdx, %rax
        addq %r8, %rax
        
        ret

rsum_list_done:
        ret

.align 8
ele1:
        .quad 0x00a
        .quad ele2
ele2:
        .quad 0x0b0
        .quad ele3
ele3:
        .quad 0xc00
        .quad 0

.pos 0x400
stack:
